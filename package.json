{
  "name": "callsheet-app",
  "productName": "Call Sheet",
  "version": "1.1.0",
  "description": "Local live-show call sheet builder and runner",
  "main": "main.js",
  "author": "Matthew Sosdorf",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac",
    "test": "node tests/sync-core.test.js && node tests/script-parse.test.js && node tests/shotsheet-formats.test.js"
  },
  "build": {
    "appId": "com.callsheet.app",
    "productName": "Call Sheet",
    "files": [
      "main.js",
      "preload.js",
      "pdf-text.js",
      "src/**/*",
      "node_modules/@fontsource/bebas-neue/**/*",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/legacy/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/legacy/build/pdf.{sandbox,min,worker.min}*"
    ],
    "fileAssociations": [
      {
        "ext": "callsheet",
        "name": "Call Sheet",
        "role": "Editor"
      },
      {
        "ext": "shotsheet",
        "name": "Shot Sheet",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
