{
  "name": "production-tools",
  "productName": "Production Tools",
  "version": "1.3.0",
  "description": "Scripts, call sheets, shot lists and shoot scheduling for film and TV production",
  "main": "main.js",
  "author": "Matthew Sosdorf",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hypercouch1/film-tv-production-tools.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac",
    "test": "node tests/sync-core.test.js && node tests/script-parse.test.js && node tests/shotsheet-formats.test.js && node tests/screenplay.test.js && node tests/updates.test.js && node tests/history.test.js && node tests/weather.test.js && node tests/schedule.test.js && node tests/breakdown.test.js && node tests/post.test.js && node tests/release-notes.test.js && node --no-warnings tests/cloud.test.js"
  },
  "build": {
    "appId": "com.callsheet.app",
    "productName": "Production Tools",
    "publish": [
      {
        "provider": "github",
        "owner": "hypercouch1",
        "repo": "film-tv-production-tools"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "pdf-text.js",
      "updates.js",
      "src/**/*",
      "node_modules/@fontsource/bebas-neue/**/*",
      "node_modules/@fontsource/courier-prime/**/*",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/legacy/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/legacy/build/pdf.{sandbox,min,worker.min}*"
    ],
    "fileAssociations": [
      {
        "ext": "callsheet",
        "name": "Call Sheet",
        "role": "Editor"
      },
      {
        "ext": "shotsheet",
        "name": "Shot Sheet",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Production-Tools-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Production-Tools-${version}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "Production-Tools-${version}-${arch}.${ext}"
    },
    "mac": {
      "artifactName": "Production-Tools-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "electron-updater": "6.8.9",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
